# Telegram API credentials (optional)
# If unset, built-in public Telegram app defaults are used; you can also set them in the panel.
# Get your own at https://my.telegram.org
# TG_API_ID=your_api_id_here
# TG_API_HASH=your_api_hash_here

# Application secret (required in production)
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=your_secret_key_here

# Optional: admin password on first boot
# If unset, a one-time random password is written to data/.admin_bootstrap_password
# ADMIN_PASSWORD=change_me

# Optional: CORS origins for separate frontend dev server (comma-separated)
# APP_CORS_ALLOW_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173

# Optional: trust X-Forwarded-For / X-Real-IP from a reverse proxy
# APP_TRUST_PROXY_HEADERS=0

# Optional runtime
PORT=8080
APP_HOST=0.0.0.0
APP_DATA_DIR=/data
# Local non-Docker SPA static dir (Docker image uses /web)
# APP_WEB_DIR=./frontend/dist
TZ=Asia/Shanghai

# Panel 2FA TOTP window tolerance (default 1)
# APP_TOTP_VALID_WINDOW=1

# Telegram session mode (default file)
# TG_SESSION_MODE=file
# TG_SESSION_NO_UPDATES=0
# TG_GLOBAL_CONCURRENCY=1
# TG_PROXY=socks5://127.0.0.1:1080

# Task execution timeout seconds (default 300)
# SIGN_TASK_EXECUTION_TIMEOUT=300
